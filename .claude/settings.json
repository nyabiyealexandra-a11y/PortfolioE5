{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": ["portfolio", "serena"],
  "permissions": {
    "allow": [
      "mcp__portfolio",
      "Bash(npm run check)",
      "Bash(npm run build)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run lint:fix)",
      "Bash(npm run format)",
      "Bash(npm run format:check)",
      "Bash(npm test)",
      "Bash(node --test *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": ["Read(./dist/**)", "Read(./node_modules/**)", "Read(./package-lock.json)", "Read(./.serena/cache/**)"]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/node.sh --env-file" }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/node.sh \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.ts"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/node.sh \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/after-edit.ts",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/node.sh \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/before-stop.ts",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
