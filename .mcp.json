{
  "mcpServers": {
    "portfolio": {
      "command": "${CLAUDE_PROJECT_DIR:-.}/.claude/node.sh",
      "args": ["${CLAUDE_PROJECT_DIR:-.}/.claude/mcp/server.ts"]
    },
    "serena": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena@v2.1.0",
        "serena",
        "start-mcp-server",
        "--context",
        "claude-code",
        "--project",
        "${CLAUDE_PROJECT_DIR:-.}",
        "--open-web-dashboard",
        "false"
      ]
    }
  }
}
