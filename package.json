{
  "name": "portfolio-e5",
  "version": "1.0.0",
  "private": true,
  "description": "Portfolio BTS SIO SISR (épreuve E5) d'Alexandra Nyabiye — site statique une page.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node src/build.ts",
    "dev": "node --watch-path=src --watch-path=public src/build.ts",
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
